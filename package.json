{
  "name": "ai-roundtable",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "AI Roundtable 4.0 — Groq(GPT-OSS) + Gemini + AI 사회자 자동 회의 (React + Vite PWA + Cloudflare Workers)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "icons": "python3 scripts/gen_icons.py",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:tail": "wrangler tail --config worker/wrangler.toml",
    "worker:secret:groq": "wrangler secret put GROQ_API_KEY --config worker/wrangler.toml",
    "worker:secret:gemini": "wrangler secret put GEMINI_API_KEY --config worker/wrangler.toml",
    "worker:secret:token": "wrangler secret put APP_ACCESS_TOKEN --config worker/wrangler.toml",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "test:e2e": "python3 e2e/auto_meeting.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "wrangler": "^4.20.0"
  }
}
